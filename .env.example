# ===========================
# FleetOS – Environment Variables
# ===========================
# Copy this file to .env and fill in the values.
# NEVER commit .env to source control.

# ---- Application ----
APP_ENV=development
APP_PORT=5000
APP_NAME=FleetOS

# ---- Database (Supabase PostgreSQL) ----
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_SCHEMA=public

# ---- Supabase Storage ----
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_KEY=[YOUR-SERVICE-KEY]
SUPABASE_STORAGE_BUCKET=fleetos

# ---- JWT ----
JWT_SECRET=[GENERATE-A-STRONG-SECRET-MIN-64-CHARS]
JWT_ISSUER=fleetos-api
JWT_AUDIENCE=fleetos-clients
JWT_ACCESS_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=30

# ---- Redis ----
REDIS_CONNECTION_STRING=redis:6379
REDIS_PASSWORD=[YOUR-REDIS-PASSWORD]
REDIS_DEFAULT_TTL_MINUTES=60

# ---- Serilog / Logging ----
LOG_LEVEL=Information
SEQ_URL=http://seq:5341

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Rate Limiting ----
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ---- Frontend (Vite) ----
VITE_API_URL=http://localhost:5000
VITE_APP_NAME=FleetOS
VITE_APP_VERSION=1.0.0

# ---- PostgreSQL (local Docker) ----
POSTGRES_DB=fleetos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=[YOUR-DB-PASSWORD]
POSTGRES_PORT=5432

# ---- Admin Initial Seed ----
SEED_SYSTEM_ADMIN_EMAIL=admin@fleetos.io
SEED_SYSTEM_ADMIN_PASSWORD=[GERAR-SENHA-FORTE-12-CARACTERES]
SEED_TENANT_NAME=Baby Turismo
SEED_ORG_NAME=Baby Turismo LTDA
SEED_TENANT_ADMIN_EMAIL=admin@babyturismo.com.br
SEED_TENANT_ADMIN_PASSWORD=[GERAR-SENHA-FORTE-12-CARACTERES]
